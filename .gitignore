# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated audio, caches, and anything produced by a run
/.cache
/out
# Voice auditions: ship the small AAC previews so the picker works on a fresh clone,
# but never the raw WAVs they were made from.
/public/auditions/*.wav

# Local Netlify folder
.netlify
public/_scale.json

# CLI render outputs (audio, scripts)
/artifacts
